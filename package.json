{
  "name": "terminal-donut",
  "version": "0.1.0",
  "description": "DOUGHNUT3D: a spinning 3D ASCII donut for your terminal and browser, steered by phone tilt or mouse.",
  "type": "module",
  "private": true,
  "scripts": {
    "step1": "node lessons/01-frame.js",
    "step2": "node lessons/02-circle.js",
    "step3": "node lessons/03-torus.js",
    "step4": "node lessons/04-spin.js",
    "step5": "node lessons/05-donut.js",
    "start": "node src/main.js",
    "web": "python3 -m http.server 8000",
    "demo:record": "node --experimental-websocket tools/record-demo.mjs .demo-frames",
    "demo:gif": "python3 tools/make-gif.py .demo-frames docs/media/doughnut3d-x.gif 1120 256 global"
  },
  "engines": {
    "node": ">=18"
  }
}
